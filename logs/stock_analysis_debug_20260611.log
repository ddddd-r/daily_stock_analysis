ies': {'stock_code': {'type': 'string', 'description': "Stock code, e.g., '600519'"}, 'days': {'type': 'integer', 'description': 'Number of recent trading days to scan (default: 60)'}}, 'required': ['stock_code']}}}, {'type': 'function', 'function': {'name': 'search_stock_news', 'description': 'Search for the latest news articles about a specific stock. Requires both stock_code and stock_name for accurate search. Returns news titles, snippets, sources, and URLs.', 'parameters': {'type': 'object', 'properties': {'stock_code': {'type': 'string', 'description': "Stock code, e.g., '600519'"}, 'stock_name': {'type': 'string', 'description': "Stock name in Chinese, e.g., '贵州茅台'"}}, 'required': ['stock_code', 'stock_name']}}}, {'type': 'function', 'function': {'name': 'search_comprehensive_intel', 'description': 'Multi-dimensional intelligence search: latest news, market analysis, risk checking, earnings outlook, and industry trends for a stock. Returns a formatted report and structured results.', 'parameters': {'type': 'object', 'properties': {'stock_code': {'type': 'string', 'description': "Stock code, e.g., '600519'"}, 'stock_name': {'type': 'string', 'description': "Stock name in Chinese, e.g., '贵州茅台'"}}, 'required': ['stock_code', 'stock_name']}}}, {'type': 'function', 'function': {'name': 'get_market_indices', 'description': 'Get major market indices (e.g., Shanghai Composite, Shenzhen Component, CSI 300 for China; S&P 500, Nasdaq, Dow for US). Provides market overview.', 'parameters': {'type': 'object', 'properties': {'region': {'type': 'string', 'description': "Market region: 'cn' for China A-shares, 'us' for US stocks (default: 'cn')", 'enum': ['cn', 'us']}}}}}, {'type': 'function', 'function': {'name': 'get_sector_rankings', 'description': 'Get sector/industry performance rankings. Returns top N and bottom N sectors by daily change percentage. Useful for sector rotation analysis.', 'parameters': {'type': 'object', 'properties': {'top_n': {'type': 'integer', 'desc